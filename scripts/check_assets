from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent
if str(ROOT_DIR) not in sys.path:
    sys.path.insert(0, str(ROOT_DIR))

from scripts import newauto_mcp as core


def main() -> int:
    parser = argparse.ArgumentParser(description="Check project Flow/image asset coverage.")
    parser.add_argument("--project-id", required=True, help="newauto project id.")
    args = parser.parse_args()
    core._configure_stdout()
    print(core.flow_asset_coverage(str(args.project_id)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
